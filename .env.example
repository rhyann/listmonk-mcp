LISTMONK_URL=https://listmonk.example.com
LISTMONK_USER=hermes_newsletter
LISTMONK_TOKEN=replace-me
# Keep false unless this MCP instance should delete data, send messages, or administer Listmonk.
LISTMONK_ENABLE_SENSITIVE_TOOLS=false
LISTMONK_TOOL_GROUPS=all
